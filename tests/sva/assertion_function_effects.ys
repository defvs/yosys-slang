design -reset

# The clock and the defaults of a scope are part of the assertions using them
test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module clock_call(input logic clk, input logic a, output logic seen);
	initial seen = 1'b0;
	function logic note(logic x);
		seen = x;
		return x;
	endfunction
	assert property (@(posedge note(clk)) a);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module procedural_clock_call(input logic clk, input logic a, output logic seen);
	initial seen = 1'b0;
	function logic note(logic x);
		seen = x;
		return x;
	endfunction
	always @(posedge clk)
