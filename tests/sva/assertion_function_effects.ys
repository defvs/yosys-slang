design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module clock_argument(input logic clk, input logic a, output logic seen);
	initial seen = 1'b0;
	function logic note(logic x);
		seen = x;
		return x;
	endfunction
	property holds(c, x);
		@(posedge c) x;
	endproperty
	assert property (holds(note(clk), a));
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module default_clocking_call(input logic clk, input logic a);
	function logic divided(logic x);
		logic phase;
		divided = x & phase;
		phase = !phase;
	endfunction
	default clocking @(posedge divided(clk)); endclocking
	assert property (a);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module default_disable_call(input logic clk, input logic a, input logic rst, output logic seen);
	initial seen = 1'b0;
	function logic note(logic x);
		seen = x;
		return x;
	endfunction
	default disable iff (note(rst));
	always @(posedge clk)
		assert property (a);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module sequence_argument(input logic clk, input logic a, input logic b, output logic [3:0] cnt);
	initial cnt = 4'd0;
	function logic bump(logic x);
		cnt = cnt + 4'd1;
		return x;
	endfunction
	sequence then_b(x);
		x ##1 b;
	endsequence
	cover property (@(posedge clk) then_b(bump(a)));
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module nested_other_static(input logic clk, input logic a, input logic b);
	function logic remember(logic x);
		logic seen;
		seen = x;
		return x;
	endfunction
	function logic forget(logic x);
		remember.seen = 1'b0;
		return x;
	endfunction
	function automatic logic outer(logic x);
		logic y;
		y = forget(x);
		return y;
	endfunction
	always @(posedge clk)
		assume property (a |=> outer(b));
endmodule
EOF

design -reset

# A hierarchical name reads what the last call left in a static variable, and we lower
# what a call in an assertion assigns as the call's own: the design, or another function
# or assertion, would see something else there
test_slangdiag -expect "function called in a concurrent assertion assigns a variable a hierarchical name refers to"
read_slang <<EOF
module named_static(input logic clk, input logic [3:0] b, output logic [3:0] q);
	function automatic logic [3:0] keep(logic [3:0] x);
		static logic [3:0] last = 4'd0;
		last = x;
		return x;
	endfunction
	always @(posedge clk)
		q <= keep.last;
	assert property (@(posedge clk) keep(b) == b);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable a hierarchical name refers to"
read_slang <<EOF
module static_after_call(input logic clk, input logic [3:0] a, output logic [3:0] q);
	function automatic logic [3:0] keep(logic [3:0] x);
		static logic [3:0] last;
		last = x;
		return x;
	endfunction
	function automatic logic changed(logic [3:0] x);
		logic [3:0] r;
		r = keep(x);
		return keep.last != x;
	endfunction
	always_comb
		q = keep(a + 4'd1);
	assert property (@(posedge clk) !changed(a));
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable a hierarchical name refers to"
read_slang <<EOF
module static_read_by_assertion(input logic clk, input logic [3:0] b);
	function automatic logic [3:0] keep(logic [3:0] x);
		static logic [3:0] last = 4'd0;
		last = x;
		return x;
	endfunction
	assert property (@(posedge clk) keep(b) == b);
	assert property (@(posedge clk) ##1 keep.last == $past(b));
endmodule
EOF

design -reset

# The arguments of a static function are static variables too, assigned by each call
test_slangdiag -expect "function called in a concurrent assertion assigns a variable a hierarchical name refers to"
read_slang <<EOF
module named_argument(input logic clk, input logic [3:0] b, output logic [3:0] q);
	function logic [3:0] same(logic [3:0] x);
		return x;
	endfunction
	always @(posedge clk)
		q <= same.x;
	assert property (@(posedge clk) same(b) == b);
endmodule
EOF

design -reset

# A function reading a static variable of a function whose call it runs in reads what
# that call has assigned so far, or else what an earlier one left. The callee is looked
# into first here, from the assertion, where the same read is of a sampled value.
test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module static_read_by_callee(input logic clk, input logic [3:0] b);
	function logic [3:0] previous(logic [3:0] x);
		logic [3:0] acc;
		previous = peek(x);
		acc = x;
	endfunction
	function automatic logic [3:0] peek(logic [3:0] x);
		return previous.acc;
	endfunction
	assert property (@(posedge clk) peek(b) == peek(b) && previous(b) == 4'd0);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module design_static_read_by_callee(input logic clk, input logic [3:0] b);
	function logic [3:0] outer(logic [3:0] x);
		logic [3:0] acc;
		return x + inner(x);
	endfunction
	function automatic logic [3:0] inner(logic [3:0] x);
		return x & middle(x);
	endfunction
	function automatic logic [3:0] middle(logic [3:0] x);
		return outer.acc;
	endfunction
	always @(posedge clk)
		outer.acc <= b;
	assert property (@(posedge clk) outer(b) != 4'd0);
endmodule
EOF

design -reset

# Parts assigned on only some paths leave the rest to an earlier call, and a
# nonblocking assignment is made only after the read
test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module partial_fill(input logic clk, input logic a, input logic [3:0] v);
	function logic [3:0] half(logic s, logic [3:0] x);
		logic [3:0] t;
		t[1:0] = x[1:0];
		if (s)
			t[3:2] = x[3:2];
		return t;
	endfunction
	assert property (@(posedge clk) half(a, v) != 4'hf);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module nonblocking_state(input logic clk, input logic [3:0] v);
	function logic [3:0] delayed(logic [3:0] x);
		logic [3:0] t;
		t <= x;
		return t;
	endfunction
	assert property (@(posedge clk) delayed(v) == v);
endmodule
EOF

design -reset

# An output argument of a call does not count as assigning the variable either
test_slangdiag -expect "function called in a concurrent assertion may read state left by an earlier call"
read_slang <<EOF
module output_argument_state(input logic clk, input logic [3:0] v);
	function automatic void give(input logic [3:0] x, output logic [3:0] y);
		y = x;
	endfunction
	function logic [3:0] passed(logic [3:0] x);
		logic [3:0] t;
		give(x, t);
		return t;
	endfunction
	assert property (@(posedge clk) passed(v) == v);
endmodule
EOF

design -reset

test_slangdiag -expect "function called in a concurrent assertion assigns a variable not its own"
read_slang <<EOF
module module_memory_load(input logic clk, input logic [1:0] i);
	logic m [4];
	function logic lookup(logic [1:0] idx);
		$readmemh("function_table.hex", m);
		return m[idx];
	endfunction
	assert property (@(posedge clk) lookup(i) || i == 2'd1);
endmodule
EOF

design -reset

# Immediate assertions run their expression in the enclosing process, where the
# function's writes are ordinary procedural assignments
read_slang <<EOF
module immediate_call(input logic clk, input logic a, output logic [3:0] cnt);
	initial cnt = 4'd0;
	function logic bump(logic x);
		cnt = cnt + 4'd1;
		return x;
	endfunction
	always @(posedge clk)
		assert (bump(a));
endmodule
EOF
select -assert-count 1 t:$check

design -reset

# Functions that keep nothing between calls are fine, whether they are automatic or
# assign their static variables before reading them on every path
read_slang <<EOF
package pure_pkg;
	function logic [3:0] reversed(logic [3:0] x);
		logic [3:0] r;
		r = 4'd0;
		for (int i = 0; i < 4; i++)
			r[i] = x[3 - i];
		return r;
	endfunction
endpackage

module pure_functions(input logic clk, input logic [3:0] v, input logic [1:0] s, input logic a);
	function automatic int ones(logic [3:0] x);
		int n = 0;
		foreach (x[i])
			if (x[i])
				n++;
		return n;
	endfunction

	function logic [3:0] decode(logic [1:0] sel);
		case (sel)
			2'd0: decode = 4'b0001;
			2'd1: decode = 4'b0010;
			2'd2: decode = 4'b0100;
			2'd3: decode = 4'b1000;
		endcase
	endfunction

	function logic [3:0] first_one(logic [3:0] x);
		logic [3:0] t;
		if (x == 4'd0)
			return 4'd0;
		t = x & -x;
		return t;
	endfunction

	function logic [3:0] twice(logic [3:0] x);
		return pure_pkg::reversed(pure_pkg::reversed(x));
	endfunction

	function automatic logic [3:0] with_static(logic [3:0] x);
		static logic [3:0] scratch;
		scratch = x;
		for (int i = 0; i < 3; i++)
			if (scratch[0] == 1'b0)
				scratch = scratch >> 1;
		return scratch;
	endfunction

	always @(posedge clk) begin
		assert property (ones(v) <= 4);
		assert property ($onehot(decode(s)));
		assert property (v == 4'd0 || $onehot(first_one(v)));
		assert property (twice(v) == v);
	end
	// Only the design calls it, what it leaves there is state like any other
	function logic [3:0] latch(logic [3:0] x);
		logic [3:0] k;
		k = x;
		return k;
	endfunction

	function automatic logic latched_ones(logic [3:0] x);
		return ones(latch.k) == ones(x);
	endfunction

	logic [3:0] q;
	always @(posedge clk)
		q <= latch(v);

	// $readmem assigns the function's own memory
	function automatic logic lookup(logic [1:0] idx);
		logic m [4];
		$readmemh("function_table.hex", m);
		return m[idx];
	endfunction

	// Parts selected by constants add up to the whole variable
	function logic [3:0] swap(logic [3:0] x);
		logic [3:0] t;
		t[1:0] = x[3:2];
		if (x[0]) begin
			t[3:2] = x[1:0];
		end else begin
			t[3] = x[1];
			t[2] = x[0];
		end
		return t;
	endfunction

	typedef struct packed {
		logic [1:0] hi;
		logic [1:0] lo;
	} halves_t;

	function halves_t split(logic [3:0] x);
		halves_t h;
		h.hi = x[3:2];
		h.lo = x[1:0];
		return h;
	endfunction

	assert property (@(posedge clk) v == 4'd0 || with_static(v)[0]);
	assert property (@(posedge clk) a |-> const'(ones(v)) == ones(v));
	assert property (@(posedge twice({3'd0, clk})[0]) ones(v) <= 4);
	assert property (@(posedge clk) latched_ones(q));
	assert property (@(posedge clk) swap(swap(v)) == v);
	assert property (@(posedge clk) split(v) == v);
	assert property (@(posedge clk) lookup(s) || s == 2'd1);
endmodule
EOF
select -assert-count 11 t:$check
