test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module range_guard(input logic clk, input logic a, input logic b);
	large_delay_test: assert property (@(posedge clk) a ##[0:1025] b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module repetition_guard(input logic clk, input logic a);
	large_repetition_test: assert property (@(posedge clk) a[*1:1025]);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module nested_repetition_guard(input logic clk, input logic a, input logic z);
	large_nested_test: assert property (@(posedge clk) ((a[*1000])[*1000])[*1000] |-> z);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module overflowing_repetition_guard(input logic clk);
	huge_nested_test: assert property (@(posedge clk) (((1'b1[*1024])[*1024])[*1024])[*1024]);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module path_product_guard(input logic clk, input logic a);
	large_product_test: assert property (@(posedge clk) (1'b1[*1:1024])[*1:2] |-> a);
endmodule
EOF

design -reset

# The limits on a whole assertion have to leave room for a range of the maximum size
read_slang <<EOF
module within_guards(input logic clk, input logic a);
	largest_range_test: assert property (@(posedge clk) 1'b1 ##[0:1024] 1'b1);
	nested_repetition_test: assert property (@(posedge clk) (a[*100])[*100]);
endmodule
EOF

select -assert-count 2 t:$check
