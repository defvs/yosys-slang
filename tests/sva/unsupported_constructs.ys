	nonconsecutive_test: assert property (@(posedge clk) a |-> b[=2]);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module goto_repetition(input logic clk, input logic a, input logic b);
	goto_test: assert property (@(posedge clk) a |-> b[->2]);
endmodule
