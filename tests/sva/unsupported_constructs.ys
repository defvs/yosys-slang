test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_repetition_plus(input logic clk, input logic a, input logic b);
	unbounded_repetition_test: assert property (@(posedge clk) b ##1 a[+]);
endmodule
EOF

