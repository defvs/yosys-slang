# Each construct here has no exact lowering to a check, so it is an error rather than
# something left out or approximated. docs/sva.md lists these along with the rejections
# tested elsewhere.

# Unbounded delays and repetitions wait for a match with no bound on the ticks
test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_delay(input logic clk, input logic a, input logic b);
	unbounded_delay_test: assert property (@(posedge clk) a ##[1:$] b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_delay_shorthand(input logic clk, input logic a, input logic b);
	unbounded_delay_test: assert property (@(posedge clk) a ##[+] b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_delay_star(input logic clk, input logic a, input logic b);
	unbounded_delay_test: assert property (@(posedge clk) a ##[*] b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_repetition(input logic clk, input logic a, input logic b);
	unbounded_repetition_test: assert property (@(posedge clk) a[*1:$] ##1 b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unbounded_repetition_shorthand(input logic clk, input logic a, input logic b);
	unbounded_repetition_test: assert property (@(posedge clk) b ##1 a[*]);
endmodule
EOF

