design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module sequence_within(input logic clk, input logic a, input logic b, input logic c);
	within_test: assert property (@(posedge clk) c |-> (a ##1 b) within (c ##3 c));
endmodule
EOF

design -reset

# A match item runs on each match of the sequence, which a check has no way to do
test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module match_item_call(input logic clk, input logic a, input logic b, input logic c);
	match_item_test: assert property (@(posedge clk) (a ##1 b, $display("matched")) |=> c);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module first_match_item(input logic clk, input logic a, input logic b, input logic c);
	first_match_item_test: assert property (@(posedge clk)
		first_match(a ##[1:2] b, $display("matched")) |=> c);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported system task 'triggered'"
read_slang <<EOF
module sequence_triggered(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	triggered_test: assert property (@(posedge clk) s.triggered |-> a);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported system task 'matched'"
read_slang <<EOF
module sequence_matched(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	matched_test: assert property (@(posedge clk) s.matched |-> a);
endmodule
EOF

design -reset

# Property operators outside the subset: those over unbounded time, the temporal ones
# with no bounded lowering here, aborts, and properties chosen by a condition
test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module property_always(input logic clk, input logic a, input logic b);
	always_test: assert property (@(posedge clk) a |-> always b);
endmodule
EOF

