	recursive_test: assert property (@(posedge clk) p);
endmodule
EOF

design -reset

# Restrictions and sequence covers are other statements than assert, assume and cover
# of a property
test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module restrict_statement(input logic clk, input logic a);
	restrict_test: restrict property (@(posedge clk) a);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module cover_sequence(input logic clk, input logic a, input logic b);
	cover_sequence_test: cover sequence (@(posedge clk) a ##1 b);
endmodule
EOF

design -reset

# A clock is a single edge of a 1-bit signal
test_slangdiag -expect "SVA clocking requires a signal edge"
read_slang <<EOF
module clock_without_edge(input logic clk, input logic a, input logic b);
	no_edge_test: assert property (@(clk) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA clocking requires a signal edge"
read_slang <<EOF
module sequence_clock(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a;
	endsequence
	sequence_clock_test: assert property (@(s) b);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA clocking requires a signal edge"
read_slang <<EOF
module global_clock(input logic clk, input logic a, input logic b);
	global clocking @(posedge clk); endclocking
	global_clock_test: assert property (@($global_clock) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA clocking requires a signal edge"
read_slang <<EOF
module clocking_block_clock(input logic clk, input logic a, input logic b);
	default clocking cb @(posedge clk); endclocking
	clocking_block_test: assert property (@(cb) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "@(edge) will not be synthesized (override with '--allow-dual-edge-ff')"
read_slang --allow-dual-edge-ff <<EOF
module dual_edge_clock(input logic clk, input logic a, input logic b);
	dual_edge_test: assert property (@(edge clk) a |=> b);
endmodule
EOF

design -reset

# A process on both edges of its clock queues attempts on both edges, also for an
# assertion of a single tick or with a clock of its own
test_slangdiag -expect "@(edge) will not be synthesized (override with '--allow-dual-edge-ff')"
read_slang --allow-dual-edge-ff <<EOF
module dual_edge_process(input logic clk, input logic a, input logic b);
	always @(edge clk)
		dual_edge_process_test: assert property (a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "@(edge) will not be synthesized (override with '--allow-dual-edge-ff')"
read_slang --allow-dual-edge-ff <<EOF
module dual_edge_process_single_tick(input logic clk, input logic a);
	always @(edge clk)
		dual_edge_single_tick_test: assert property (a);
endmodule
EOF

design -reset

test_slangdiag -expect "@(edge) will not be synthesized (override with '--allow-dual-edge-ff')"
read_slang --allow-dual-edge-ff <<EOF
module dual_edge_process_own_clock(input logic clk, input logic en, input logic a,
								   input logic b);
	always @(edge clk)
		if (en)
			dual_edge_own_clock_test: assert property (@(negedge clk) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "@(edge) will not be synthesized (override with '--allow-dual-edge-ff')"
read_slang --allow-dual-edge-ff <<EOF
module dual_edge_process_reset(input logic clk, input logic rst, input logic a,
							   output logic q);
	always @(edge clk or posedge rst) begin
		if (rst) begin
			q <= 0;
		end else begin
			q <= a;
			dual_edge_reset_test: assert property (a);
		end
	end
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module clock_event_list(input logic clk, input logic rst, input logic a, input logic b);
	event_list_test: assert property (@(posedge clk or posedge rst) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "iff qualifier not supported in combination with this event"
read_slang <<EOF
module default_clocking_iff(input logic clk, input logic en, input logic a, input logic b);
	default clocking @(posedge clk iff en); endclocking
	default_iff_test: assert property (a |=> b);
endmodule
EOF

design -reset

# An explicit clock in a process has to be the one the process runs on
test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module explicit_clock_in_other_process(input logic clk, input logic clk2, input logic a,
									   input logic b);
	always @(posedge clk)
		other_clock_test: assert property (@(posedge clk2) a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module multiclocked_property(input logic clk, input logic clk2, input logic a, input logic b);
	multiclock_test: assert property (@(posedge clk) a |=> @(posedge clk2) b);
endmodule
EOF

design -reset

# Delays count the ticks of one clock edge
test_slangdiag -expect "SVA temporal delay requires exactly one clock edge"
read_slang <<EOF
module delay_without_clock(input logic a, input logic b);
	no_clock_test: assert property (a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA temporal delay requires exactly one clock edge"
read_slang <<EOF
module delay_in_comb_without_clock(input logic a, input logic b);
	always_comb
		comb_test: assert property (a |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA temporal delay requires exactly one clock edge"
read_slang <<EOF
module delay_in_reset_branch(input logic clk, input logic rst, input logic a, input logic b,
							 input logic d, output logic q);
	always @(posedge clk or posedge rst) begin
		if (rst) begin
			q <= 1'b0;
		end else begin
			reset_branch_test: assert property (a |=> b);
			q <= d;
		end
	end
endmodule
EOF

design -reset

# An initial procedure has no clock to give, see initial_attempt.sv and
# initial_own_clock.sv for assertions that take the default clocking or a clock of their own
test_slangdiag -expect "SVA temporal delay requires exactly one clock edge"
read_slang <<EOF
module delay_in_initial(input logic clk, input logic a, input logic b);
	initial
		initial_test: assert property (a |=> b);
endmodule
EOF

design -reset

# Clocking blocks other than the default one are rejected like other timing controls
test_slangdiag -expect "unsynthesizable timing control (ignore with '--ignore-timing')"
read_slang <<EOF
module named_clocking_block(input logic clk, input logic a);
	clocking cb @(posedge clk); endclocking
endmodule
EOF

design -reset

test_slangdiag -expect "unsynthesizable timing control (ignore with '--ignore-timing')"
read_slang <<EOF
module global_clocking_block(input logic clk, input logic a);
	global clocking @(posedge clk); endclocking
endmodule
EOF

design -reset

# Sampled value functions take the clock of the assertion or process they're in
test_slangdiag -expect "$past gating_expr (3rd argument) and clocking_event (4th argument) are not supported"
read_slang <<EOF
module past_gating(input logic clk, input logic a, input logic b, input logic en);
	past_gating_test: assert property (@(posedge clk) b |-> $past(a, 1, en));
endmodule
EOF

design -reset

test_slangdiag -expect "$past gating_expr (3rd argument) and clocking_event (4th argument) are not supported"
read_slang <<EOF
module past_clocking(input logic clk, input logic clk2, input logic a, input logic b);
	past_clocking_test: assert property (@(posedge clk) b |-> $past(a, 1, , @(posedge clk2)));
endmodule
EOF

design -reset

test_slangdiag -expect "system function '$past' can only be called within a clocked procedural block with explicit timing"
read_slang <<EOF
module past_without_clock(input logic a, input logic b);
	always_comb
		past_test: assert ($past(a) == b);
endmodule
EOF

design -reset

test_slangdiag -expect "system function '$rose' can only be called within a clocked procedural block with explicit timing"
read_slang <<EOF
module rose_without_clock(input logic a, input logic b);
	rose_test: assert property ($rose(a) |-> b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported system task '$sampled'"
read_slang <<EOF
module sampled_function(input logic clk, input logic a, input logic b);
	sampled_test: assert property (@(posedge clk) $sampled(a) |=> b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported system task '$past_gclk'"
read_slang <<EOF
module global_clock_past(input logic clk, input logic a, input logic b);
	global clocking @(posedge clk); endclocking
	past_gclk_test: assert property (@(posedge clk) a |-> $past_gclk(b));
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported system task '$rose_gclk'"
read_slang <<EOF
module global_clock_rose(input logic clk, input logic a, input logic b);
	global clocking @(posedge clk); endclocking
	rose_gclk_test: assert property (@(posedge clk) a |-> $rose_gclk(b));
endmodule
EOF
