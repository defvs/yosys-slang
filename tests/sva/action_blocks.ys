test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module procedural_fail_action(input logic clk, input logic a, output logic err);
	initial err = 1'b0;
	always @(posedge clk)
		assert property (a) else err <= 1'b1;
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module freestanding_pass_action(input logic clk, input logic a, output logic hit);
	initial hit = 1'b0;
	cover property (@(posedge clk) a) hit <= 1'b1;
endmodule
EOF

