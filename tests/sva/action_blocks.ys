test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module immediate_actions(input logic clk, input logic a, output logic q);
	always @(posedge clk)
		assert (a) q <= 1'b1; else q <= 1'b0;
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module nested_action(input logic a, input logic b, output logic q);
	always_comb begin
		q = 1'b0;
		assert (a) else begin
			$error("a low");
			if (b)
				q = 1'b1;
		end
	end
endmodule
EOF

design -reset

# Reporting is all an action block is left to do
read_slang <<EOF
module reporting_actions(input logic clk, input logic a, input logic b);
	always @(posedge clk) begin
		assert (a) else $error("a low");
		assert property (b) $display("b high"); else begin
			if (a)
				$warning("b low");
			else
				$fatal(1, "a and b low");
		end
	end
	assume property (@(posedge clk) a |=> b) else $info("b late");
endmodule
EOF

select -assert-count 3 t:$check

design -reset

# Ending the simulation, writing to files or monitoring is nothing the design can see
# either, and an action may use control flow and variables of its own for its reports
read_slang <<EOF
module effect_free_actions(input logic clk, input logic a, input logic b, input logic [3:0] v);
	int fd;

	function automatic int ones(logic [3:0] x);
		int n = 0;
		for (int i = 0; i < 4; i++)
			n += x[i];
		return n;
	endfunction

	function logic [3:0] swapped(logic [3:0] x);
		logic [3:0] y;
		y = {x[1:0], x[3:2]};
		return y;
	endfunction

	always @(posedge clk) begin
		assert (a) else $finish;
		assert (a) else $stop(0);
		assert (a) else $exit;
		assert (a) $finish(1); else $fatal(1, "a low");
		assert (a) else $fdisplay(32'h8000_0002, "a low");
		assert (a) else begin
			$fwrite(fd, "a low");
			$fstrobe(fd, "a low");
			$fflush(fd);
		end
		assert (a) else begin
			$monitor("%b", a);
			$monitoroff;
			$monitoron;
			$fmonitor(fd, "%b", b);
		end
		assert (a) else begin
			string s;
			s = $sformatf("a=%b v=%h", a, v);
			$error(s);
		end
		assert (a) else case (b)
			1'b0: $error("b low");
			default: $warning("b high");
		endcase
		assert (a) else for (int i = 0; i < 2; i++) $error("%0d", i);
		assert (a) else repeat (2) $info("again");
		assert (a) else foreach (v[i]) $display("%b", v[i]);
		assert (a) else begin
			int n;
			n = 0;
			while (n < 2)
				n++;
			do n--; while (n > 0);
			$error("%0d %0d %h", n, ones(v), swapped(v));
		end
		assert property (b) else begin
			$error("b low");
			$stop;
		end
		assert property (b) $display("b high at %0t", $time); else $finish;
	end

	assert property (@(posedge clk) a) else begin
		$error("a low");
		$stop;
	end
	cover property (@(posedge clk) a ##1 b) $display("hit, %0d ones", ones(v));
	assume property (@(posedge clk) a |=> b) else case (v)
		4'h0: $info("v zero");
		default: $info("v nonzero");
	endcase
endmodule
EOF

select -assert-count 18 t:$check

design -reset

# The arguments of a report can have effects too
test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module argument_side_effect(input logic clk, input logic a, output logic [7:0] cnt);
	initial cnt = 8'd0;
	always @(posedge clk)
		assert (a) else $error("%0d", cnt++);
endmodule
EOF

