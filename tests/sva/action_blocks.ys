design -reset

test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module impure_function(input logic clk, input logic a, output logic [7:0] fails);
	initial fails = 8'd0;
	function automatic logic [7:0] count_fail();
		fails = fails + 8'd1;
		return fails;
	endfunction
	always @(posedge clk)
		assert (a) else $error("%0d failures", count_fail());
endmodule
EOF

design -reset

# The call of a function which keeps state changes what the next call returns
test_slangdiag -expect "unsupported statement in assertion action block"
read_slang <<EOF
module stateful_function(input logic clk, input logic a, output logic y);
	function logic toggle();
		static logic state = 1'b0;
		state = !state;
		return state;
	endfunction
	always @(posedge clk) begin
		y <= toggle();
		assert (a) else $display("%b", toggle());
	end
endmodule
EOF

design -reset

