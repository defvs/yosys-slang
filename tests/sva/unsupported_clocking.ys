test_slangdiag -expect "iff qualifier not supported in combination with this event"
read_slang <<EOF
module unsupported_clocking(input logic clk, input logic en, input logic a);
	iff_test: assert property (@(posedge clk iff en) a);
endmodule
EOF

select -assert-none t:$check

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module multibit_clocking(input logic [1:0] clk, input logic a);
	multibit_test: assert property (@(posedge clk) a);
endmodule
EOF

select -assert-none t:$check

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module explicit_clock_in_guarded_process(input logic clk, input logic en, input logic a, input logic b);
	always_ff @(posedge clk iff en) begin
		guarded_test: assert property (@(posedge clk) a |=> b);
	end
endmodule
EOF

select -assert-none t:$check

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module explicit_clock_in_reset_branch(input logic clk, input logic rst, input logic a, input logic b,
									  input logic d, output logic q);
	always_ff @(posedge clk or posedge rst) begin
		if (rst) begin
			reset_test: assert property (@(posedge clk) a |=> b);
			q <= 1'b0;
		end else begin
			q <= d;
		end
	end
endmodule
EOF

select -assert-none t:$check

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module repeated_clocked_sequence(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	repeated_test: assert property (s[*2]);
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module nested_repeated_clocked_sequence(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	sequence twice;
		s[*2];
	endsequence
	repeated_test: cover property (twice);
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module default_clocked_repeated_sequence(input logic clk, input logic a, input logic b);
	default clocking @(posedge clk); endclocking
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	repeated_test: assert property (s[*1:2]);
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module procedural_repeated_sequence(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	property p;
		s[*2];
	endproperty
	always @(posedge clk) begin
		repeated_test: assert property (p);
	end
endmodule
EOF

design -reset

test_slangdiag -expect "unsynthesizable feature"
read_slang <<EOF
module default_clocking_event(input logic clk, input logic d, output logic q);
	default clocking cb @(posedge clk); endclocking
	always @(cb) q <= d;
endmodule
EOF

design -reset

test_slangdiag -expect "unsynthesizable feature"
read_slang <<EOF
module sequence_event(input logic clk, input logic a, input logic b, input logic d, output logic q);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	always @(s) q <= d;
endmodule
EOF

design -reset

test_slangdiag -expect "clocking block signals unsupported"
read_slang <<EOF
module clocking_block_input(input logic clk, input logic a, input logic b);
	default clocking cb @(posedge clk);
		input a, b;
	endclocking
	input_test: assert property (cb.a |=> cb.b);
endmodule
EOF

design -reset

test_slangdiag -expect "clocking block signals unsupported"
read_slang <<EOF
module clocking_block_output(input logic clk, input logic d, output logic q);
	default clocking cb @(posedge clk);
		output q;
	endclocking
	always @(posedge clk) cb.q <= d;
endmodule
EOF
