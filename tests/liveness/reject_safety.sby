[tasks]
pass
fail

[options]
mode prove
# sby loses the job slot of an engine process it stops before its end, and
# once it has lost them all the tasks left never start: the base case and
# the induction both run to their end instead
wait on
timeout 300
depth 10
fail: expect fail

[engines]
smtbmc z3

[script]
pass: read_rtlil reject_abort_pass.il
pass: chformal -live -remove
pass: chformal -fair -remove
pass: prep -top reject_abort_pass
fail: read_rtlil reject_abort_fail.il
fail: chformal -live -remove
fail: chformal -fair -remove
fail: prep -top reject_abort_fail

[files]
reject_abort_pass.il
reject_abort_fail.il
