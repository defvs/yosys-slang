test_slangdiag -expect "liveness expression needs an acceptance condition that cannot be represented by Yosys $live/$fair cells"
read_slang <<EOF
module unsupported_generalized_liveness(
	input logic clk,
	input logic a,
	input logic b
);
	assume property (@(posedge clk) strong(a ##[0:$] b));
endmodule
EOF

design -reset

test_slangdiag -expect "cover of an `always`, `until` or liveness property is not a finite reachability check"
read_slang <<EOF
module unsupported_liveness_cover(input logic clk, input logic a);
	cover property (@(posedge clk) s_eventually a);
endmodule
EOF

design -reset

test_slangdiag -expect "SVA match items and local-variable actions are not synthesizable"
read_slang <<EOF
module unsupported_match_item(
	input logic clk,
	input logic a,
	input logic b
);
	function void note_match();
	endfunction
	assert property (@(posedge clk) strong((a, note_match()) ##1 b));
endmodule
EOF

design -reset

test_slangdiag -expect "cover of an `always`, `until` or liveness property is not a finite reachability check"
read_slang <<EOF
module unsupported_bounded_always_cover(input logic clk, input logic a);
	cover property (@(posedge clk) always [0:2] a);
endmodule
EOF

design -reset

test_slangdiag -expect "cover of an `always`, `until` or liveness property is not a finite reachability check"
read_slang <<EOF
module unsupported_split_cover(input logic clk, input logic a, input logic b);
	cover property (@(posedge clk) (a until b) and (b until a));
endmodule
EOF

design -reset

# Where `c` is low these succeed with no check started to show it
test_slangdiag -expect "cover of a property `if`, `case` or `implies`, or of an implication with an unbounded antecedent, is unsupported"
read_slang <<EOF
module unsupported_if_cover(input logic clk, input logic c, input logic a, input logic b);
	cover property (@(posedge clk) if (c) a ##1 b);
endmodule
EOF

design -reset

test_slangdiag -expect "cover of a property `if`, `case` or `implies`, or of an implication with an unbounded antecedent, is unsupported"
read_slang <<EOF
module unsupported_implies_cover(input logic clk, input logic x, input logic c,
								 input logic a);
	cover property (@(posedge clk) accept_on (x) c implies a);
endmodule
EOF

design -reset

test_slangdiag -expect "cover of a property `if`, `case` or `implies`, or of an implication with an unbounded antecedent, is unsupported"
read_slang <<EOF
module unsupported_case_cover(input logic clk, input logic c, input logic a);
	cover property (@(posedge clk) case (c) 1'b1: a; endcase);
endmodule
EOF

design -reset

# An attempt with a match of the antecedent followed by `b` can fail on a later one
test_slangdiag -expect "cover of a property `if`, `case` or `implies`, or of an implication with an unbounded antecedent, is unsupported"
read_slang <<EOF
module unsupported_unbounded_antecedent_cover(input logic clk, input logic c,
											  input logic a, input logic b);
	cover property (@(posedge clk) c ##1 a[*1:$] |-> b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module unsupported_unbounded_first_match(
	input logic clk,
	input logic a,
	input logic b,
	input logic c
);
	assert property (@(posedge clk) first_match(a ##[1:$] b) |-> c);
endmodule
EOF

design -reset

# One monitor for both sides of an `or` can't select an attempt for one of them
test_slangdiag -expect "liveness expression needs an acceptance condition that cannot be represented by Yosys $live/$fair cells"
read_slang <<EOF
module unsupported_selected_or(
	input logic clk,
	input logic a,
	input logic b,
	input logic c
);
	assert property (@(posedge clk) (s_eventually strong(a[*1:$] ##1 b)) or (s_eventually c));
endmodule
EOF

design -reset

# The clock of a repeated sequence instance belongs to that sequence, also in the
# monitors and response obligations
test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module repeated_clocked_strong(input logic clk, input logic a);
	sequence s;
		@(posedge clk) ##[1:$] a;
	endsequence
	assert property (@(posedge clk) strong(s[*2]));
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module repeated_clocked_eventually(input logic clk, input logic a, input logic b);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	assert property (@(posedge clk) s_eventually s[*2]);
endmodule
EOF

design -reset

test_slangdiag -expect "encountered unsupported SVA feature"
read_slang <<EOF
module repeated_clocked_conditional(input logic clk, input logic a, input logic b, input logic c);
	sequence s;
		@(posedge clk) a ##1 b;
	endsequence
	assert property (@(posedge clk) if (c) s[*2]);
endmodule
EOF

design -reset

# A repeated sequence is no Boolean operand for `until` or `implies`
test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module repeated_until_operand(input logic clk, input logic a, input logic b);
	sequence s;
		a;
	endsequence
	assert property (@(posedge clk) b until s[*2]);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module repeated_implies_operand(input logic clk, input logic a, input logic b);
	sequence s;
		a;
	endsequence
	assert property (@(posedge clk) s[*2] implies b);
endmodule
EOF

design -reset

# A monitor merging the attempts of `a ##1 b` can't tell whether one of them is still
# in flight when the reject comes, and so whether it fails
test_slangdiag -expect "`reject_on` is supported around a liveness property with no safety part and nothing but a boolean antecedent ahead of its obligations"
read_slang <<EOF
module reject_sequence_antecedent(input logic clk, input logic r, input logic a,
								  input logic b, input logic c);
	assert property (@(posedge clk) reject_on (r) (a ##1 b |-> s_eventually c));
endmodule
EOF

design -reset

test_slangdiag -expect "`reject_on` is supported around a liveness property with no safety part and nothing but a boolean antecedent ahead of its obligations"
read_slang <<EOF
module reject_safety_part(input logic clk, input logic r, input logic a, input logic b);
	assert property (@(posedge clk) reject_on (r) (a s_until b));
endmodule
EOF

design -reset

# A sequence used as a property is weak in an assertion or an assumption (IEEE
# 1800-2017 16.12.2). With an unbounded match it holds as long as one is still to
# come, so this assumption constrains nothing, while reading it strong would make
# `b` come.
test_slangdiag -expect "weak sequence with an unbounded match is unsupported, in `assert` and `assume` a sequence used as a property is weak unless written `strong(...)`"
read_slang <<EOF
module weak_eventual_assume(input logic clk, input logic b);
	assume property (@(posedge clk) s_eventually (##[1:$] b));
endmodule
EOF

design -reset

test_slangdiag -expect "weak sequence with an unbounded match is unsupported, in `assert` and `assume` a sequence used as a property is weak unless written `strong(...)`"
read_slang <<EOF
module weak_eventual_assert(input logic clk, input logic a, input logic b);
	assert property (@(posedge clk) a |-> s_eventually (a ##[1:$] b));
endmodule
EOF

design -reset

test_slangdiag -expect "weak sequence with an unbounded match is unsupported, in `assert` and `assume` a sequence used as a property is weak unless written `strong(...)`"
read_slang <<EOF
module weak_eventual_named(input logic clk, input logic a, input logic b);
	sequence s;
		a[*1:$] ##1 b;
	endsequence
	assert property (@(posedge clk) s_eventually [2:$] s);
endmodule
EOF

