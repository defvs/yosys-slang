test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module not_strong_unbounded(input logic clk, input logic a, input logic b);
	assert property (@(posedge clk) not strong(a ##[1:$] b));
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module nexttime_liveness(input logic clk, input logic a, input logic b);
	assert property (@(posedge clk) a |=> s_nexttime s_eventually b);
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module bounded_eventually_liveness(input logic clk, input logic a, input logic b);
	assert property (@(posedge clk) s_eventually [0:3] (s_eventually b));
endmodule
EOF

design -reset

test_slangdiag -expect "unsupported assertion statement"
read_slang <<EOF
module eventually_always(input logic clk, input logic a);
	assert property (@(posedge clk) s_eventually always a);
endmodule
EOF

design -reset

# A temporal operand with no liveness in it is no different
test_slangdiag -expect "property needs an acceptance condition that Yosys $live/$fair cells and safety checks cannot represent: `or` with a temporal operand unless both are unbounded eventualities, `iff` or the left of `implies` with a temporal operand, or an unbounded sequence whose attempts would each need a selection, under an eventuality or in an assumption"
read_slang <<EOF
module or_until_boolean(input logic clk, input logic a, input logic b, input logic c);
	assert property (@(posedge clk) (a until b) or c);
endmodule
EOF

design -reset

test_slangdiag -expect "property needs an acceptance condition that Yosys $live/$fair cells and safety checks cannot represent: `or` with a temporal operand unless both are unbounded eventualities, `iff` or the left of `implies` with a temporal operand, or an unbounded sequence whose attempts would each need a selection, under an eventuality or in an assumption"
read_slang <<EOF
module implies_until(input logic clk, input logic a, input logic b, input logic c);
	assert property (@(posedge clk) (a until b) implies c);
endmodule
EOF

design -reset

# The vacuous successes of a nested `if` go unseen as well
test_slangdiag -expect "cover of a property with a property `if`, `case` or `implies` in it, or with an implication that has an unbounded antecedent or `if`, `case`, `implies`, `iff` or an abort in its consequent, is unsupported, as no check would see its vacuous successes"
read_slang <<EOF
module if_and_cover(input logic clk, input logic a, input logic b, input logic c);
	cover property (@(posedge clk) (if (a) b) and c);
endmodule
EOF

design -reset

test_slangdiag -expect "cover of a property with a property `if`, `case` or `implies` in it, or with an implication that has an unbounded antecedent or `if`, `case`, `implies`, `iff` or an abort in its consequent, is unsupported, as no check would see its vacuous successes"
read_slang <<EOF
module followed_if_cover(input logic clk, input logic x, input logic a, input logic b);
	cover property (@(posedge clk) x #-# (if (a) b));
endmodule
EOF
