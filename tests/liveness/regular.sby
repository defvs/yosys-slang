[tasks]
pass
fail
intersect_pass
intersect_fail
goto_pass
goto_fail
within_pass
within_fail
and_pass
and_fail
or_pass
or_fail
throughout_pass
throughout_fail
nonconsecutive_pass
nonconsecutive_fail
consecutive_pass
consecutive_fail
empty_fusion_pass
empty_fusion_fail

[options]
mode live
fail: expect fail
intersect_fail: expect fail
goto_fail: expect fail
within_fail: expect fail
and_fail: expect fail
or_fail: expect fail
throughout_fail: expect fail
nonconsecutive_fail: expect fail
consecutive_fail: expect fail
empty_fusion_fail: expect fail

[engines]
aiger suprove

[script]
pass: read_rtlil regular_sequence_pass.il
pass: chformal -cover -remove
pass: prep -top regular_sequence_pass
fail: read_rtlil regular_sequence_fail.il
fail: chformal -cover -remove
fail: prep -top regular_sequence_fail
intersect_pass: read_rtlil regular_intersect_pass.il
intersect_pass: chformal -cover -remove
intersect_pass: prep -top regular_intersect_pass
intersect_fail: read_rtlil regular_intersect_fail.il
intersect_fail: chformal -cover -remove
intersect_fail: prep -top regular_intersect_fail
goto_pass: read_rtlil regular_goto_pass.il
goto_pass: chformal -cover -remove
goto_pass: prep -top regular_goto_pass
goto_fail: read_rtlil regular_goto_fail.il
goto_fail: chformal -cover -remove
goto_fail: prep -top regular_goto_fail
within_pass: read_rtlil regular_within_pass.il
within_pass: chformal -cover -remove
within_pass: prep -top regular_within_pass
within_fail: read_rtlil regular_within_fail.il
within_fail: chformal -cover -remove
within_fail: prep -top regular_within_fail
and_pass: read_rtlil regular_and_pass.il
and_pass: chformal -cover -remove
and_pass: prep -top regular_and_pass
and_fail: read_rtlil regular_and_fail.il
and_fail: chformal -cover -remove
and_fail: prep -top regular_and_fail
or_pass: read_rtlil regular_or_pass.il
or_pass: chformal -cover -remove
or_pass: prep -top regular_or_pass
or_fail: read_rtlil regular_or_fail.il
or_fail: chformal -cover -remove
or_fail: prep -top regular_or_fail
throughout_pass: read_rtlil regular_throughout_pass.il
throughout_pass: chformal -cover -remove
throughout_pass: prep -top regular_throughout_pass
throughout_fail: read_rtlil regular_throughout_fail.il
throughout_fail: chformal -cover -remove
throughout_fail: prep -top regular_throughout_fail
nonconsecutive_pass: read_rtlil regular_nonconsecutive_pass.il
nonconsecutive_pass: chformal -cover -remove
nonconsecutive_pass: prep -top regular_nonconsecutive_pass
nonconsecutive_fail: read_rtlil regular_nonconsecutive_fail.il
nonconsecutive_fail: chformal -cover -remove
nonconsecutive_fail: prep -top regular_nonconsecutive_fail
consecutive_pass: read_rtlil regular_consecutive_pass.il
consecutive_pass: chformal -cover -remove
consecutive_pass: prep -top regular_consecutive_pass
consecutive_fail: read_rtlil regular_consecutive_fail.il
consecutive_fail: chformal -cover -remove
consecutive_fail: prep -top regular_consecutive_fail
empty_fusion_pass: read_rtlil regular_empty_fusion_pass.il
empty_fusion_pass: chformal -cover -remove
empty_fusion_pass: prep -top regular_empty_fusion_pass
empty_fusion_fail: read_rtlil regular_empty_fusion_fail.il
empty_fusion_fail: chformal -cover -remove
empty_fusion_fail: prep -top regular_empty_fusion_fail

[files]
regular_sequence_pass.il
regular_sequence_fail.il
regular_intersect_pass.il
regular_intersect_fail.il
regular_goto_pass.il
regular_goto_fail.il
regular_within_pass.il
regular_within_fail.il
regular_and_pass.il
regular_and_fail.il
regular_or_pass.il
regular_or_fail.il
regular_throughout_pass.il
regular_throughout_fail.il
regular_nonconsecutive_pass.il
regular_nonconsecutive_fail.il
regular_consecutive_pass.il
