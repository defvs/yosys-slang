# There's no limit on the size of a range, ranges past 1024 lower like any other.
# Each of these takes a few registers per tick of its range.
read_slang <<EOF
module late_response(input logic clk, input logic rst, input logic a, input logic b);
	late_response_test: assert property (@(posedge clk) disable iff (rst)
		a |-> s_eventually [2000:$] b);
endmodule

module long_suffix(input logic clk, input logic rst, input logic a, input logic b, input logic c);
	long_suffix_test: assert property (@(posedge clk) disable iff (rst)
		a |-> strong(##[1:$] b ##2000 c));
endmodule

module ranged_always(input logic clk, input logic a, input logic b);
	ranged_always_test: assert property (@(posedge clk) a |-> always [0:1500] b);
endmodule

module not_always(input logic clk, input logic a);
	not_always_test: assert property (@(posedge clk) not (always [0:1500] a));
endmodule

module unbounded_antecedent(input logic clk, input logic a, input logic b, input logic c);
	unbounded_antecedent_test: assert property (@(posedge clk) a[*1:$] ##2000 b |-> c);
endmodule

module goto_delay(input logic clk, input logic a, input logic b);
	goto_delay_test: assert property (@(posedge clk) a |-> strong(b[->1500]));
endmodule

module ranged_suffix(input logic clk, input logic a, input logic b, input logic c);
	ranged_suffix_test: assert property (@(posedge clk) a |-> strong(##[1:$] b ##[1:2000] c));
endmodule

module late_always(input logic clk, input logic a);
	late_always_test: assert property (@(posedge clk) always [2000:$] a);
endmodule

module late_not_eventually(input logic clk, input logic a);
	late_not_eventually_test: assert property (@(posedge clk) not (s_eventually [2000:$] a));
endmodule

module late_not_always(input logic clk, input logic a);
	late_not_always_test: assert property (@(posedge clk) not (always [2000:$] a));
endmodule

module late_selected(input logic clk, input logic a, input logic b);
	late_selected_test: assert property (@(posedge clk) s_eventually [2000:$] (a ##[1:$] b));
endmodule

module always_response(input logic clk, input logic rst, input logic req, input logic ack);
	always_response_test: assert property (@(posedge clk) disable iff (rst)
		always (req |-> ##[1:3000] ack));
endmodule

module late_always_response(input logic clk, input logic rst, input logic a, input logic b);
	late_always_response_test: assert property (@(posedge clk) disable iff (rst)
		always [2000:$] (a |-> s_eventually b));
endmodule

module bounded_response(input logic clk, input logic req, input logic ack);
	bounded_response_test: assert property (@(posedge clk) req |-> s_eventually [0:2000] ack);
endmodule

module goto_range(input logic clk, input logic a, input logic b);
	goto_range_test: assert property (@(posedge clk) a |=> strong(b[->1:1500]));
endmodule
EOF

select -assert-count 1 late_response/t:$check r:FLAVOR=live %i
select -assert-count 1 late_response/t:$check
select -assert-max 8000 late_response/t:$dff

select -assert-count 1 long_suffix/t:$check r:FLAVOR=live %i
select -assert-count 1 long_suffix/t:$check
select -assert-max 24000 long_suffix/t:$dff

# One check over the ticks of the interval
select -assert-count 1 ranged_always/t:$check r:FLAVOR=assert %i
select -assert-count 1 ranged_always/t:$check
select -assert-none ranged_always/t:$check r:FLAVOR=live %i
select -assert-none ranged_always/t:$check r:FLAVOR=fair %i
select -assert-max 6000 ranged_always/t:$dff

select -assert-min 1 not_always/t:$check r:FLAVOR=assert %i
select -assert-none not_always/t:$check r:FLAVOR=live %i
select -assert-none not_always/t:$check r:FLAVOR=fair %i
select -assert-max 6000 not_always/t:$dff

select -assert-count 1 unbounded_antecedent/t:$check r:FLAVOR=assert %i
select -assert-count 1 unbounded_antecedent/t:$check
select -assert-max 8000 unbounded_antecedent/t:$dff

select -assert-count 1 goto_delay/t:$check r:FLAVOR=live %i
select -assert-count 1 goto_delay/t:$check r:FLAVOR=fair %i
select -assert-count 2 goto_delay/t:$check
select -assert-max 6000 goto_delay/t:$dff

# The matches of a suffix discharge the attempts of their age and older, which takes
# one OR per age rather than one per age and match
select -assert-count 1 ranged_suffix/t:$check r:FLAVOR=live %i
select -assert-count 1 ranged_suffix/t:$check
select -assert-max 24000 ranged_suffix/t:$dff
select -assert-max 40000 ranged_suffix/t:*

select -assert-count 1 late_always/t:$check r:FLAVOR=assert %i
select -assert-count 1 late_always/t:$check
select -assert-max 6000 late_always/t:$dff

select -assert-count 1 late_not_eventually/t:$check r:FLAVOR=assert %i
select -assert-count 1 late_not_eventually/t:$check
select -assert-max 6000 late_not_eventually/t:$dff

select -assert-count 1 late_not_always/t:$check r:FLAVOR=live %i
select -assert-count 1 late_not_always/t:$check
select -assert-max 6000 late_not_always/t:$dff

select -assert-count 1 late_selected/t:$check r:FLAVOR=live %i
select -assert-count 1 late_selected/t:$check r:FLAVOR=fair %i
select -assert-count 2 late_selected/t:$check
select -assert-max 6000 late_selected/t:$dff

# The attempts of the operand on all the ticks of the interval are one and the same
select -assert-count 1 always_response/t:$check r:FLAVOR=assert %i
select -assert-count 1 always_response/t:$check
select -assert-max 16000 always_response/t:$dff

select -assert-count 1 late_always_response/t:$check r:FLAVOR=live %i
select -assert-count 1 late_always_response/t:$check
select -assert-max 6000 late_always_response/t:$dff

select -assert-count 1 bounded_response/t:$check r:FLAVOR=assert %i
select -assert-count 1 bounded_response/t:$check
select -assert-max 8000 bounded_response/t:$dff

select -assert-count 1 goto_range/t:$check r:FLAVOR=live %i
select -assert-count 1 goto_range/t:$check r:FLAVOR=fair %i
select -assert-count 2 goto_range/t:$check
select -assert-max 6000 goto_range/t:$dff

async2sync
formalff -clk2ff
chformal -lower
check -assert
