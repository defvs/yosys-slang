# An automatic variable or a const cast keeps the value it had when the attempt was
# queued (IEEE Std 1800-2017 section 16.14.6.1), which the monitors only have on the
# first tick of the attempt. Read on a later tick, or for another attempt, it has to
# be rejected.
test_slangdiag -expect "automatic variable or const cast of non-constant value used past the first tick of an assertion attempt"
read_slang <<EOF
module eventual_operand(input logic clk, input logic a, input logic b);
	always @(posedge clk) begin
		automatic logic t = a ^ b;
		assert property (s_eventually t);
	end
endmodule
EOF

design -reset

test_slangdiag -expect "automatic variable or const cast of non-constant value used past the first tick of an assertion attempt"
read_slang <<EOF
module eventual_cast(input logic clk, input logic a);
	logic x;
	always @(posedge clk) begin
		x = a;
		assert property (s_eventually [2:$] const'(x));
	end
endmodule
EOF

