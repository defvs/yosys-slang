design -reset

# On the first tick of the attempt they keep their value
read_slang <<EOF
module first_tick(input logic clk, input logic a, input logic b, input logic c);
	logic x;
	always @(posedge clk) begin
		automatic logic t = a ^ b;
		x = a;
		response_check: assert property (t |-> s_eventually b);
		selected_check: assert property (strong(t ##[1:$] b));
		if_check: assert property (if (t) s_eventually b);
		case_check: assert property (case (t) 1'b1: s_eventually b; endcase);
		iff_check: assert property (t iff b);
		implies_check: assert property (t implies s_eventually b);
		always_check: assert property (always [0:0] t);
		not_always_check: assert property (not (always [0:0] t));
		followed_check: assert property (t #-# s_eventually b);
		antecedent_check: assert property (t ##1 b[*1:$] |-> c);
		cast_check: assert property (const'(x) |-> s_eventually b);
		within_check: assert property (strong(b within (t ##1 c[->1])));
	end
endmodule
EOF

select -assert-count 15 t:$check
select -assert-count 8 t:$check r:FLAVOR=live %i
select -assert-count 2 t:$check r:FLAVOR=fair %i
select -assert-count 5 t:$check r:FLAVOR=assert %i
