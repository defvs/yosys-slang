reject_vacuous_pass: prep -top reject_vacuous_pass
accept_reject_pass: read_rtlil accept_reject_pass.il
accept_reject_pass: chformal -assert -remove
accept_reject_pass: prep -top accept_reject_pass
reject_next_pass: read_rtlil reject_next_pass.il
reject_next_pass: chformal -assert -remove
