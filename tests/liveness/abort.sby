selected_accept_pass: chformal -assert -remove
selected_accept_pass: prep -top selected_accept_pass
selected_minimum_pass: read_rtlil selected_minimum_pass.il
selected_minimum_pass: chformal -assert -remove
selected_minimum_pass: prep -top selected_minimum_pass
reject_vacuous_pass: read_rtlil reject_vacuous_pass.il
