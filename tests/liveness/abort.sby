[options]
mode live
selected_settled_fail: expect fail

[engines]
aiger suprove

[script]
selected_settled_fail: read_rtlil selected_settled_fail.il
selected_settled_fail: chformal -assert -remove
selected_settled_fail: prep -top selected_settled_fail
