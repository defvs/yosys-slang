[tasks]
pass
fail

[options]
mode prove
# sby loses the job slot of an engine process it stops before its end, and
# once it has lost them all the tasks left never start: the base case and
# the induction both run to their end instead
wait on
depth 12
fail: expect fail

[engines]
smtbmc z3

[script]
pass: read_rtlil arbiter_pass.il
pass: chformal -live -remove
pass: prep -top opentitan_arbiter_liveness_harness
fail: read_rtlil arbiter_safety_fail.il
fail: chformal -live -remove
fail: prep -top opentitan_arbiter_liveness_harness

[files]
arbiter_pass.il
arbiter_safety_fail.il
